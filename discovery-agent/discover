#!/usr/bin/env python3
"""Wrapper script - use discover.py instead to avoid CRLF issues."""
import sys
import os
script_dir = os.path.dirname(os.path.abspath(__file__))
discover_py = os.path.join(script_dir, "discover.py")
if os.path.isfile(discover_py):
    os.execv(sys.executable, [sys.executable, discover_py] + sys.argv[1:])
else:
    print("Error: discover.py not found", file=sys.stderr)
    sys.exit(1)
