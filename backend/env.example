# Database Configuration
# REQUIRED: Set a secure database URL with strong credentials
# Generate secure password: python -c 'import secrets; print(secrets.token_urlsafe(16))'
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@localhost:5432/troubleshooting_ai

# Security
# REQUIRED: Generate a secure secret key for JWT tokens
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Must be at least 32 characters long
SECRET_KEY=CHANGE_ME_GENERATE_SECURE_KEY_AT_LEAST_32_CHARS

# REQUIRED: Credential encryption key for storing sensitive credentials
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_GENERATE_FERNET_KEY

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Environment (development, staging, production)
# In production, DEBUG will be automatically disabled
ENVIRONMENT=development

# CORS
ALLOWED_HOSTS=["http://localhost:3000", "http://localhost:8000"]

# Vector Store
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# LLM Provider (gemini or ollama)
LLM_PROVIDER=gemini

# Google Gemini API (Primary - Recommended)
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Default model (used as fallback - actual model selected dynamically based on complexity)
# Using n-1 strategy: stable models (2.5) instead of experimental
GEMINI_MODEL=gemini-2.5-flash
# Optional: Override model priority (comma-separated: simple,moderate,complex)
# Default uses stable models: gemini-2.5-flash,gemini-2.5-flash,gemini-2.5-pro
# GEMINI_MODEL_PRIORITY=gemini-2.5-flash,gemini-2.5-flash,gemini-2.5-pro

# Ollama/Llama (Fallback - Optional)
# Only used if GEMINI_API_KEY is not set
LLM_MODEL=llama3.1:8b
LLM_BASE_URL=http://localhost:11434

# Perplexity API (for web search and command validation)
# Get your API key from: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# File Upload
MAX_FILE_SIZE=104857600
UPLOAD_DIR=uploads

# Multi-tenant
DEFAULT_TENANT=default

# Queue / Streaming
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_ASSIGN=session.assign
REDIS_STREAM_COMMAND=session.command
REDIS_STREAM_RESULT=session.result
REDIS_STREAM_EVENTS=session.events
WORKER_ORCHESTRATION_ENABLED=true

